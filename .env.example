# Önerilen GPT metin motoru. Anahtar varsa Responses API otomatik etkinleşir.
VIDEOLUK_OPENAI_API_KEY=
VIDEOLUK_LLM_MODEL=gpt-6.1-terra

# İsteğe bağlı OpenAI-uyumlu alternatif metin servisi.
# Kendi sunucunuzdaki Ollama örneği: http://host.docker.internal:11434
VIDEOLUK_LLM_URL=
VIDEOLUK_LLM_API_KEY=

# OpenAI uyumlu görsel üretim servisi. Boşsa sistem otomatik stok medya kullanır.
# Yerel bir ComfyUI/SD geçidi veya ücretli sağlayıcının OpenAI uyumlu adresi kullanılabilir.
VIDEOLUK_IMAGE_URL=
VIDEOLUK_IMAGE_MODEL=
VIDEOLUK_IMAGE_API_KEY=
VIDEOLUK_IMAGE_TIMEOUT=180

# Uygulama içi kapalı beta hesabı. Üretimde AUTH_REQUIRED ve SECURE_COOKIES açık olmalı.
# İlk yönetici yalnızca veritabanında aynı e-posta yoksa başlangıçta oluşturulur.
VIDEOLUK_AUTH_REQUIRED=1
VIDEOLUK_ADMIN_EMAIL=yonetici@videoluk.com
VIDEOLUK_ADMIN_PASSWORD=BURAYA_EN_AZ_10_KARAKTER_GUCLU_PAROLA
VIDEOLUK_SECURE_COOKIES=1
VIDEOLUK_SESSION_TTL_DAYS=14

# Pexels ücretsiz stok video API anahtarı
VIDEOLUK_PEXELS_API_KEY=

# Coverr stok video ve müzik API anahtarı (Pexels'ten önce kullanılır)
VIDEOLUK_COVERR_API_KEY=

# Pixabay ücretsiz video API anahtarı. Girilirse Coverr sonuçlarıyla birleştirilir.
# Sonuçlar Pixabay API koşulları gereği 24 saat önbellekte tutulur.
VIDEOLUK_PIXABAY_API_KEY=

# Üretim alan adı (Caddy otomatik HTTPS için)
VIDEOLUK_DOMAIN=videoluk.example.com

# Üretim erişim koruması. Hash üretmek için:
# docker run --rm caddy:2-alpine caddy hash-password --plaintext 'guclu-parolaniz'
# Dolar işaretlerini korumak için hash değerini tek tırnak içinde yazın.
VIDEOLUK_BASIC_AUTH_USER=videoluk
VIDEOLUK_BASIC_AUTH_HASH='$2a$14$BURAYA_CADDY_HASH_DEGERI'

# CPU sunucusunda aynı anda çalışacak render sayısı ve toplam kuyruk sınırı.
VIDEOLUK_RENDER_WORKERS=1
VIDEOLUK_MAX_QUEUED_RENDERS=8

# Tek bir referans eğitim videosu için azami yükleme boyutu (bayt, varsayılan 2 GB).
VIDEOLUK_MAX_TRAINING_VIDEO_BYTES=2147483648
VIDEOLUK_MAX_UPLOAD_BYTES=524288000
VIDEOLUK_MAX_PROJECTS_PER_USER=50
VIDEOLUK_MAX_STORAGE_BYTES_PER_USER=5368709120
VIDEOLUK_MAX_MONTHLY_RENDERS_PER_USER=60
VIDEOLUK_STARTER_CREDITS=120
VIDEOLUK_PUBLIC_BASE_URL=https://app.videoluk.com
VIDEOLUK_IYZICO_BASE_URL=https://sandbox-api.iyzipay.com
VIDEOLUK_IYZICO_API_KEY=
VIDEOLUK_IYZICO_SECRET_KEY=
# Tekrarlayan ödeme sağlayıcısı, ürün kimlikleri ve webhook doğrulaması tamamlanmadan 1 yapmayın.
VIDEOLUK_SUBSCRIPTION_BILLING_ENABLED=0
VIDEOLUK_REGISTRATION_ENABLED=1
# Kullanıcının kabul ettiği hukuki metin sürümü; metin esaslı değiştiğinde güncelleyin.
VIDEOLUK_LEGAL_VERSION=2026-11-08

# İsteğe bağlı hesap e-postaları. Boş bırakılırsa davet/parola bağlantısı panelden kopyalanır.
# SECURITY: starttls (genellikle 587), ssl (genellikle 465) veya none.
VIDEOLUK_SMTP_HOST=
VIDEOLUK_SMTP_PORT=587
VIDEOLUK_SMTP_USER=
VIDEOLUK_SMTP_PASSWORD=
VIDEOLUK_SMTP_FROM=Videoluk <hesap@videoluk.com>
VIDEOLUK_SMTP_SECURITY=starttls
VIDEOLUK_SMTP_TIMEOUT=15
VIDEOLUK_PASSWORD_RESET_COOLDOWN_SECONDS=300

# Hata alarmları için Slack, Discord veya kendi HTTPS webhook adresiniz.
# Aynı hata varsayılan olarak 5 dakika içinde yalnızca bir kez gönderilir.
VIDEOLUK_ALERT_WEBHOOK_URL=
VIDEOLUK_ALERT_WEBHOOK_TOKEN=
VIDEOLUK_ALERT_COOLDOWN_SECONDS=300

# Ayrı bir web alanından API erişimi gerekiyorsa tam origin yazın; aynı origin için boş bırakın.
VIDEOLUK_ALLOWED_ORIGIN=
